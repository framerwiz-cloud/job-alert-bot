# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# --- Slack (required) ---
# api.slack.com/apps -> Create New App -> From scratch -> your app name
# -> Incoming Webhooks -> Activate -> Add New Webhook to Workspace -> pick a channel -> copy URL
SLACK_WEBHOOK_URL=


# --- Upwork, via job-alert emails (free, works today) ---
# Upwork SHUT DOWN RSS feeds in August 2024, so there is no feed to subscribe to.
# Instead the bot reads Upwork's job-alert emails out of a mailbox over IMAP.
#
# Setup:
# 1. On upwork.com, create a saved search for your keywords and turn ON its email alerts
#    (Find Work -> Saved Searches -> the bell/notification toggle, set to Instantly).
# 2. Use a Gmail account for these alerts. Enable 2-Step Verification, then create an
#    App Password at myaccount.google.com/apppasswords (a normal Gmail password will NOT work).
# 3. Put the 16-character app password below (spaces are fine, they get stripped).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# How many days back to scan for alert emails on each run. 2 is plenty for a 15-min cron.
IMAP_LOOKBACK_DAYS=2

# --- Freelancer.com (optional, public search works without a token) ---
# If Freelancer.com starts requiring auth, get a free token at developers.freelancer.com -> My Apps -> Create App
FREELANCER_OAUTH_TOKEN=

# --- Guru (optional -- no official API/RSS) ---
# Guru has no public API or RSS. Workaround: create a saved search on guru.com, copy its results URL,
# then generate a free RSS feed for that URL using a service like rss.app (free tier) and paste it here.
GURU_RSS_URL=

# --- PeoplePerHour (optional -- no official API/RSS) ---
# Same situation as Guru: use rss.app (free tier) or similar on your PPH saved-search URL.
PPH_RSS_URL=
